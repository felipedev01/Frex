generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShipmentStatus {
  PENDENTE
  EM_TRANSITO
  CONCLUIDO
}

enum NFStatus {
  PENDENTE
  ENTREGUE
  DIVERGENTE
}

model Viewer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model TransportCompany {
  id            Int        @id @default(autoincrement())
  name          String
  cnpj          String     @unique
  email         String     @unique
  password      String
  address       String?
  phone         String?
  contactPerson String?
  createdAt     DateTime   @default(now())
  
  drivers       Driver[]
  shipments     Shipment[]
}

model Driver {
  id                Int             @id @default(autoincrement())
  name              String
  transportCompanyId Int
  licensePlate      String          @unique
  email             String          @unique
  password          String
  phone             String?
  documentId        String?         // CPF ou outro documento
  
  transportCompany  TransportCompany @relation(fields: [transportCompanyId], references: [id])
  shipments         Shipment[]       @relation("DriverShipments")
}

model Shipment {
  id                 Int       @id @default(autoincrement())
  name               String
  driverId           Int
  transportCompanyId Int
  description        String
  origin             String    @default("Extrema-MG")
  destination        String
  status             String    @default("PENDENTE")
  estimatedArrival   DateTime?
  createdAt          DateTime  @default(now())
  finishedAt         DateTime?

  driver             Driver           @relation("DriverShipments", fields: [driverId], references: [id])
  transportCompany   TransportCompany @relation(fields: [transportCompanyId], references: [id])
  nfDetails          NFDetail[]
}

model NFDetail {
  id            Int       @id @default(autoincrement())
  shipmentId    Int
  nfNumber      String
  status        NFStatus  @default(PENDENTE)
  proofImage    String?
  issueType     String?   // Tipo do problema reportado
  issueDetails  String?   // Detalhes do problema
  createdAt     DateTime  @default(now())
  completedAt   DateTime? // Data em que foi entregue ou reportada
  
  shipment      Shipment  @relation(fields: [shipmentId], references: [id])
}